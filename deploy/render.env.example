# Set these in Render > Environment; never commit real credentials.
TAILSCALE_ENABLED=true
TS_HOSTNAME=staycontrol-render
TS_AUTHKEY=REPLACE_IN_RENDER_ONLY
MONGODB_DATABASE=staycontrol
# Address from your screenshot. Confirm it still belongs to your PC.
# This direct connection is only for a SINGLE-NODE replica set rs0.
# Encode username/password URI characters. authSource must match the user database.
MONGODB_URI=mongodb://REPLACE_USER:REPLACE_PASSWORD@100.96.225.102:27017/staycontrol?authSource=admin&replicaSet=rs0&directConnection=true&proxyHost=127.0.0.1&proxyPort=1055
