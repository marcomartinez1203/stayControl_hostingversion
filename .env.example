# Copia este archivo como .env en la raíz del workspace o en la carpeta del proyecto.
# MongoDB local necesita el replica set rs0: ver staycontrol/docs/mongodb-local.md.
# MongoDB escucha solo en localhost; no exponer este servidor sin autenticación a la red.
MONGODB_URI=mongodb://localhost:27017/staycontrol?replicaSet=rs0
# Alternativa Atlas: mongodb+srv://<usuario>:<db_password>@<cluster>/?appName=StayControl
# Codifica los caracteres especiales de la contraseña para una URI (por ejemplo, @ -> %40).
MONGODB_DATABASE=staycontrol

# Solo para crear el operador inicial; desactivar y retirar la contraseña después.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
# Activar al desplegar exclusivamente mediante HTTPS.
SESSION_COOKIE_SECURE=false

# Compatibilidad con datos anteriores al modo multi-hotel.
# Correo de la cuenta EXISTENTE propietaria; dejar vacío hasta confirmar al propietario.
# No cambiar después de comenzar a operar: cambia qué cuenta ve las colecciones históricas.
LEGACY_HOTEL_OWNER_EMAIL=
